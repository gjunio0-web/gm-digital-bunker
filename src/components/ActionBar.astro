---
// Phone-only action bar pinned to the bottom of the screen. Hidden once the closing
// invitation (an element with [data-convite]) is on screen or already passed.
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';
interface Props { secondary?: boolean; lang?: Lang; }
const { secondary = false, lang = 'pt-BR' } = Astro.props;
const u = t(lang);
---
<div class="action-bar" data-action-bar>
  <a class={`btn ${secondary ? 'btn--secondary' : 'btn--primary'}`} href={path('contato', lang)} data-abrir-contato>{u.cta}</a>
</div>

<style>
  .action-bar { display: none; position: sticky; bottom: 0; z-index: 20; padding: 12px 16px; background: var(--bg); border-top: 1px solid var(--line); transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear 0s; }
  .action-bar .btn { width: 100%; min-height: 48px; }
  .action-bar.is-hidden { opacity: 0; visibility: hidden; transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
  @media (max-width: 767px) { .action-bar { display: block; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-action-bar]');
  const convite = document.querySelector<HTMLElement>('[data-convite]');
  if (bar && convite && 'IntersectionObserver' in window) {
    new IntersectionObserver((entradas) => {
      const e = entradas[0];
      // Reached once the invitation's top rises above the bar, or has already scrolled past
      const alcancado = e.boundingClientRect.top < window.innerHeight - 80;
      bar.classList.toggle('is-hidden', alcancado);
    }, { threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] }).observe(convite);
  }
</script>
