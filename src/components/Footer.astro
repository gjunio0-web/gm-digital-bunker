---
// Site footer: brand line, page links and external destinations.
import { t } from '../i18n/ui';
import { path, otherLang, type Lang, type PageId } from '../i18n/routes';
import { AMAZON, LINKEDIN, HUB } from '../config';
interface Props { lang?: Lang; pageId?: PageId; }
const { lang = 'pt-BR', pageId = 'inicio' } = Astro.props;
const u = t(lang);
const hub = lang === 'en' ? `${HUB}/?lang=en` : HUB;
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__cols">
      <div class="footer__brand">
        <a href={path('inicio', lang)}>{u.brand}</a>
        <p>{u.footer.tagline}</p>
      </div>
      <nav aria-label={u.footer.pagesNav}>
        <p class="eyebrow eyebrow--muted">{u.footer.pages}</p>
        <ul>
          <li><a href={path('servicos', lang)}>{u.nav.servicos}</a></li>
          <li><a href={path('caso', lang)}>{u.nav.casos}</a></li>
          <li><a href={path('metodo', lang)}>{u.nav.metodo}</a></li>
          <li><a href={path('publicacoes', lang)}>{u.nav.publicacoes}</a></li>
          <li><a href={path('sobre', lang)}>{u.nav.sobre}</a></li>
          <li><a href={path('contato', lang)}>{u.nav.contato}</a></li>
        </ul>
      </nav>
      <nav aria-label={u.footer.externalNav}>
        <p class="eyebrow eyebrow--muted">{u.footer.also}</p>
        <ul>
          <li><a href={AMAZON}>{u.footer.book} <span aria-hidden="true">↗</span><span class="visually-hidden">{u.footer.external}</span></a></li>
          <li><a href={hub}>AI Strategy Hub <span aria-hidden="true">↗</span><span class="visually-hidden">{u.footer.external}</span></a></li>
          <li><a href={LINKEDIN}>{u.footer.linkedin} <span aria-hidden="true">↗</span><span class="visually-hidden">{u.footer.external}</span></a></li>
          <li><a href={path('privacidade', lang)}>{u.footer.privacy}</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer__base">
      <p class="meta">GM Digital Bunker™ · © 2026</p>
      <p class="meta"><span aria-current="true" class="footer__pt">{u.footer.current}</span> · <a href={path(pageId, otherLang(lang))} lang={u.langSwitch.hreflang} hreflang={u.langSwitch.hreflang}>{u.footer.other}</a></p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); }
  .footer__inner { padding-top: 64px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 48px; }
  .footer__cols { display: flex; flex-wrap: wrap; gap: 48px; }
  .footer__brand { flex: 2 1 280px; display: flex; flex-direction: column; gap: 12px; }
  .footer__brand a { font-family: var(--serif); font-weight: 600; font-size: 20px; line-height: 1; color: var(--ink); text-decoration: none; }
  .footer__brand p { margin: 0; max-width: 28rem; font-size: 15px; line-height: 1.5; }
  .footer nav { flex: 1 1 160px; }
  .footer nav .eyebrow { margin-bottom: 12px; }
  .footer ul { display: flex; flex-direction: column; gap: 4px; margin: 0; padding: 0; list-style: none; font-size: 15px; line-height: 1.5; }
  .footer ul a { display: inline-block; padding: 6px 0; color: var(--ink-body); text-decoration: none; }
  .footer ul a:hover { color: var(--ink); text-decoration: underline; }
  .footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line); }
  .footer__base p { margin: 0; }
  .footer__pt { color: var(--ink); }
  .footer__base a { color: var(--muted); }
</style>
