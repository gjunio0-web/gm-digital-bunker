---
// Opening block of every inner page: breadcrumbs, label, title, lead text and the
// grain texture the Design System asks for on the cover and on each inner opening.
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Crumb { label: string; href?: string; }
interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  lead?: string;
  titleId?: string;
  lang?: Lang;
}
const { crumbs, eyebrow, title, lead, titleId = 'titulo', lang = 'pt-BR' } = Astro.props;
const u = t(lang);
---
<section class="opening" aria-labelledby={titleId}>
  <svg class="grain" aria-hidden="true"><filter id="grao-abertura"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#grao-abertura)"/></svg>
  <div class="container opening__content">
    <nav class="crumbs" aria-label={u.crumbsLabel}>
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> / </span>}
          {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </>
      ))}
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 id={titleId} class="text">{title}</h1>
    {lead && <p class="lead" style="margin-top: 24px;">{lead}</p>}
    <slot />
  </div>
</section>
