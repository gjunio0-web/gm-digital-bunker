---
// Site header: brand, main navigation, theme toggle and the primary action.
// On phones the navigation collapses into a real menu (same list, toggled).
interface Props { current?: string; ctaSecondary?: boolean; }
const { current = '', ctaSecondary = false } = Astro.props;
const items = [
  { id: 'servicos', label: 'Serviços', href: '/servicos' },
  { id: 'casos', label: 'Casos', href: '/casos/elite-90-pro' },
  { id: 'metodo', label: 'Método', href: '/metodo' },
  { id: 'publicacoes', label: 'Publicações', href: '/publicacoes' },
  { id: 'sobre', label: 'Sobre', href: '/sobre' },
];
const ctaClass = (current === 'contato' || ctaSecondary) ? 'btn btn--secondary' : 'btn btn--primary';
---
<header class="site-header">
  <div class="site-header__row">
    <a class="brand" href="/">GM Digital Bunker™</a>
    <nav class="nav" id="nav-principal" aria-label="Principal">
      <ul>
        {items.map((i, n) => (
          <li style={`--i: ${n}`}><a href={i.href} aria-current={current === i.id ? 'page' : undefined}>{i.label}</a></li>
        ))}
        <li class="nav__cta" style={`--i: ${items.length}`}><a class={ctaClass} href="/contato" data-abrir-contato>Agendar conversa</a></li>
      </ul>
    </nav>
    <div class="tools">
      <a href="/en/" lang="en" hreflang="en" aria-label="English version" class="lang">EN</a>
      <button type="button" class="btn btn--icon" data-tema aria-label="Mudar para tema claro">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path stroke-linecap="round" d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
      </button>
      <a class={`${ctaClass} tools__cta`} href="/contato" data-abrir-contato>Agendar conversa</a>
      <button type="button" class="btn btn--icon menu-btn" aria-expanded="false" aria-controls="nav-principal" aria-label="Menu">
        <svg class="menu-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path class="menu-icon__a" stroke-linecap="round" d="M4 7h16"/><path class="menu-icon__b" stroke-linecap="round" d="M4 12h16"/><path class="menu-icon__c" stroke-linecap="round" d="M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--line); }
  .site-header__row { display: flex; align-items: center; gap: 32px; height: var(--header-h); padding: 0 var(--gutter); }
  .brand { font-family: var(--serif); font-weight: 600; font-size: 20px; line-height: 1; font-variation-settings: 'opsz' 24; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .nav ul { display: flex; gap: 24px; margin: 0; padding: 0; list-style: none; }
  .nav a:not(.btn) { display: inline-flex; align-items: center; min-height: 44px; font: 600 16px/1.25 var(--sans); color: var(--ink-body); text-decoration: none; text-underline-offset: 8px; text-decoration-thickness: 1px; }
  .nav a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }
  .nav__cta { display: none; }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .lang { display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; font: 500 13px/1.5 var(--mono); color: var(--ink-body); text-decoration: none; }
  .menu-btn { display: none; }

  @media (max-width: 1023px) {
    /* Menu: the panel travels menu-shift down over dur-slow while fading in; the items follow,
       staggered. Closing is quicker (dur-base), with no stagger; visibility is delayed so the
       panel stays clickable until it is gone. */
    .nav { position: absolute; left: 0; right: 0; top: var(--header-h); background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow-overlay); padding: 8px var(--gutter) 16px; opacity: 0; visibility: hidden; transform: translateY(calc(-1 * var(--menu-shift))); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
    .nav.is-open { opacity: 1; visibility: visible; transform: none; transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out), visibility 0s linear 0s; }
    .nav li { opacity: 0; transform: translateY(calc(-1 * var(--reveal-shift))); transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
    .nav.is-open li { opacity: 1; transform: none; transition-duration: var(--dur-slow); transition-delay: calc(var(--i, 0) * var(--stagger)); }
    /* Icon: the three lines become an × */
    .menu-icon path { transform-origin: 12px 12px; transition: transform var(--dur-base) var(--ease-in-out), opacity var(--dur-fast) var(--ease-out); }
    .menu-btn[aria-expanded="true"] .menu-icon__a { transform: translateY(5px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] .menu-icon__b { opacity: 0; }
    .menu-btn[aria-expanded="true"] .menu-icon__c { transform: translateY(-5px) rotate(-45deg); }
    .nav ul { flex-direction: column; gap: 0; }
    .nav li { border-top: 1px solid var(--line); }
    .nav a:not(.btn) { min-height: 48px; width: 100%; }
    .nav__cta { display: block; padding-top: 12px; }
    .nav__cta a.btn { width: 100%; min-height: 48px; }
    .tools__cta, .tools .btn--icon[data-tema] { display: none; }
    .menu-btn { display: inline-flex; }
    .tools { gap: 8px; }
  }
</style>

<script>
  // Mobile menu toggle
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('nav-principal');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Menu');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) { nav.classList.remove('is-open'); btn?.setAttribute('aria-expanded', 'false'); btn?.focus(); }
  });

  // Theme toggle, remembered between visits
  const temaBtn = document.querySelector<HTMLButtonElement>('[data-tema]');
  const rotulo = () => {
    const claro = document.documentElement.dataset.theme === 'light';
    temaBtn?.setAttribute('aria-label', claro ? 'Mudar para tema escuro' : 'Mudar para tema claro');
  };
  rotulo();
  temaBtn?.addEventListener('click', () => {
    const claro = document.documentElement.dataset.theme === 'light';
    if (claro) delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = 'light';
    try { localStorage.setItem('tema', claro ? 'escuro' : 'claro'); } catch {}
    rotulo();
  });
</script>
