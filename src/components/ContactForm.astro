---
// The one contact form, used by the Contato page and by the dialog.
// Netlify Forms markup. Disabled until the Privacy page is approved (see README).
import { EMAIL_CONTATO } from '../config';
interface Props { idPrefix?: string; }
const { idPrefix = 'f' } = Astro.props;
const DESATIVADO = true;
const id = (s: string) => `${idPrefix}-${s}`;
---
<form class="form" name="contato" method="POST" action="/contato?enviado=1" data-netlify="true" data-netlify-honeypot="empresa-site" novalidate data-contato-form data-desativado={DESATIVADO ? 'true' : undefined}>
  <input type="hidden" name="form-name" value="contato" />
  <p class="visually-hidden"><label>Não preencha este campo: <input name="empresa-site" tabindex="-1" autocomplete="off" /></label></p>

  <div class="form__alert" role="alert" tabindex="-1" hidden data-resumo></div>
  {DESATIVADO && (
    <p class="form__aviso">O envio ficará ativo quando a página de Privacidade for publicada. Até lá, escreva para <a href={`mailto:${EMAIL_CONTATO}`}>{EMAIL_CONTATO}</a>.</p>
  )}

  <div class="form__field">
    <label for={id('nome')}>Nome <span>(obrigatório)</span></label>
    <p class="form__erro" id={id('nome-erro')} hidden>Erro: informe o nome.</p>
    <input id={id('nome')} name="nome" type="text" autocomplete="name" required aria-required="true" aria-describedby={id('nome-erro')} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('empresa')}>Empresa <span>(obrigatório)</span></label>
    <p class="form__erro" id={id('empresa-erro')} hidden>Erro: informe a empresa.</p>
    <input id={id('empresa')} name="empresa" type="text" autocomplete="organization" required aria-required="true" aria-describedby={id('empresa-erro')} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('email')}>E-mail <span>(obrigatório)</span></label>
    <p class="form__erro" id={id('email-erro')} hidden>Erro: informe o e-mail no formato nome@empresa.com.br.</p>
    <input id={id('email')} name="email" type="email" autocomplete="email" required aria-required="true" aria-describedby={id('email-erro')} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('mensagem')}>Mensagem <span>(opcional)</span></label>
    <p class="form__ajuda" id={id('mensagem-ajuda')}>O assunto que a empresa quer tratar na conversa</p>
    <textarea id={id('mensagem')} name="mensagem" rows="5" aria-describedby={id('mensagem-ajuda')} disabled={DESATIVADO}></textarea>
  </div>
  <div class="form__foot">
    <button type="submit" class="btn btn--primary" disabled={DESATIVADO}>Enviar pedido de conversa</button>
    <p class="form__dados">Os dados deste formulário servem apenas para responder a este contato. Ver <a href="/privacidade">Privacidade</a>.</p>
  </div>
</form>

<style>
  .form { display: flex; flex-direction: column; gap: 24px; }
  .form__field { display: flex; flex-direction: column; gap: 8px; }
  .form label { font-weight: 600; font-size: 16px; color: var(--ink); }
  .form label span { font-weight: 400; color: var(--muted); }
  .form input, .form textarea { width: 100%; min-height: 48px; padding: 0 14px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-md); font: 400 17px/1.5 var(--sans); color: var(--ink); }
  .form textarea { padding: 12px 14px; resize: vertical; }
  .form input:disabled, .form textarea:disabled { opacity: 0.6; }
  .form [aria-invalid="true"] { border: 2px solid var(--ink); }
  .form__erro { margin: 0; font-weight: 600; font-size: 15px; color: var(--ink); }
  .form__ajuda { margin: 0; font-size: 15px; color: var(--muted); }
  .form__alert { padding: 16px 20px; border: 2px solid var(--ink); border-radius: var(--radius-md); font-weight: 600; color: var(--ink); }
  .form__aviso { margin: 0; padding: 16px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); font-size: 15px; line-height: 1.5; }
  .form__foot { display: flex; flex-direction: column; gap: 16px; padding-top: 8px; }
  .form__foot .btn { align-self: flex-start; min-height: 48px; padding: 0 24px; font-size: 17px; }
  .form__dados { margin: 0; font-size: 15px; line-height: 1.5; color: var(--muted); }
  .form__dados a { color: var(--ink-body); }
</style>

<script>
  // Client-side validation (on blur and on submit), per the information architecture
  document.querySelectorAll<HTMLFormElement>('[data-contato-form]').forEach((form) => {
    const campos = ['nome', 'empresa', 'email'];
    const rx = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const valida = (name: string) => {
      const el = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      const erro = el?.nextElementSibling instanceof HTMLElement ? null : form.querySelector<HTMLElement>(`#${el?.id}-erro`);
      if (!el) return true;
      const msg = form.querySelector<HTMLElement>(`#${el.id}-erro`);
      const ok = name === 'email' ? rx.test(el.value.trim()) : el.value.trim().length > 0;
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      if (msg) msg.hidden = ok;
      return ok;
    };
    campos.forEach((c) => form.querySelector(`[name="${c}"]`)?.addEventListener('blur', () => valida(c)));
    form.addEventListener('submit', (e) => {
      if (form.dataset.desativado) { e.preventDefault(); return; }
      const erros = campos.filter((c) => !valida(c));
      const resumo = form.querySelector<HTMLElement>('[data-resumo]');
      if (erros.length) {
        e.preventDefault();
        if (resumo) { resumo.hidden = false; resumo.textContent = `Erro: há ${erros.length} ${erros.length === 1 ? 'campo' : 'campos'} a corrigir.`; resumo.focus(); }
        form.querySelector<HTMLInputElement>(`[name="${erros[0]}"]`)?.focus();
        return;
      }
      if (resumo) resumo.hidden = true;
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }
    });
  });
</script>
