---
// The one contact form, used by the Contato page and by the dialog.
// Sends JSON with fetch() to the receberFicha function (spec 01; see functions/ and README) and shows
// the result in place, without reloading. Sending needs JavaScript; without it, a notice points to e-mail.
import { EMAIL_CONTATO, FUNCAO_RECEBER_FICHA, FORMULARIO_ATIVO } from '../config';
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';
interface Props { idPrefix?: string; lang?: Lang; }
const { idPrefix = 'f', lang = 'pt-BR' } = Astro.props;
const u = t(lang);
const DESATIVADO = !FORMULARIO_ATIVO;
const id = (s: string) => `${idPrefix}-${s}`;
// Role options: stable English values; labels come from ui.ts
const CARGOS = ['owner', 'ceo', 'director', 'manager', 'specialist', 'external', 'other'] as const;
---
<p class="form__alert form__sucesso" role="status" tabindex="-1" hidden data-contato-sucesso>{u.form.success}</p>
<form class="form" name="contato" novalidate data-contato-form data-funcao={FUNCAO_RECEBER_FICHA} data-desativado={DESATIVADO ? 'true' : undefined} data-sending={u.form.sending} data-err-one={u.form.errSummary(1)} data-err-many={u.form.errSummary(2).replace('2', '{n}')} data-err-unavailable={u.form.errUnavailable} data-email={EMAIL_CONTATO}>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="pagina" value="" />
  <p class="visually-hidden"><label>{u.form.honeypot} <input name="empresa-site" tabindex="-1" autocomplete="off" /></label></p>

  <div class="form__alert" role="alert" tabindex="-1" hidden data-resumo></div>
  {DESATIVADO && (
    <p class="form__aviso">{u.form.notice} <a href={`mailto:${EMAIL_CONTATO}`}>{EMAIL_CONTATO}</a>.</p>
  )}
  {!DESATIVADO && (
    <noscript><p class="form__aviso">{u.form.noScript} <a href={`mailto:${EMAIL_CONTATO}`}>{EMAIL_CONTATO}</a>.</p></noscript>
  )}

  <div class="form__field">
    <label for={id('nome')}>{u.form.name} <span>{u.form.required}</span></label>
    <p class="form__erro" id={id('nome-erro')} hidden>{u.form.errName}</p>
    <input id={id('nome')} name="nome" maxlength="120" type="text" autocomplete="name" required aria-required="true" aria-describedby={id('nome-erro')} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('empresa')}>{u.form.company} <span>{u.form.required}</span></label>
    <p class="form__erro" id={id('empresa-erro')} hidden>{u.form.errCompany}</p>
    <input id={id('empresa')} name="empresa" maxlength="160" type="text" autocomplete="organization" required aria-required="true" aria-describedby={id('empresa-erro')} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('cargo')}>{u.form.role} <span>{u.form.required}</span></label>
    <p class="form__erro" id={id('cargo-erro')} hidden>{u.form.errRole}</p>
    <select id={id('cargo')} name="cargo" autocomplete="organization-title" required aria-required="true" aria-describedby={id('cargo-erro')} disabled={DESATIVADO}>
      <option value="" disabled selected>{u.form.roleSelect}</option>
      {CARGOS.map((c) => <option value={c}>{u.form.roles[c]}</option>)}
    </select>
  </div>
  <div class="form__field">
    <label for={id('email')}>{u.form.email} <span>{u.form.required}</span></label>
    <p class="form__erro" id={id('email-erro')} hidden>{u.form.errEmail}</p>
    <input id={id('email')} name="email" maxlength="254" type="email" autocomplete="email" required aria-required="true" aria-describedby={id('email-erro')} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('site')}>{u.form.website} <span>{u.form.optional}</span></label>
    <p class="form__ajuda" id={id('site-ajuda')}>{u.form.websiteHelp}</p>
    <p class="form__erro" id={id('site-erro')} hidden>{u.form.errWebsite}</p>
    <input id={id('site')} name="site" maxlength="300" type="url" inputmode="url" autocomplete="url" aria-describedby={`${id('site-ajuda')} ${id('site-erro')}`} disabled={DESATIVADO} />
  </div>
  <div class="form__field">
    <label for={id('mensagem')}>{u.form.message} <span>{u.form.optional}</span></label>
    <p class="form__ajuda" id={id('mensagem-ajuda')}>{u.form.messageHelp}</p>
    <textarea id={id('mensagem')} name="mensagem" rows="5" maxlength="4000" aria-describedby={id('mensagem-ajuda')} disabled={DESATIVADO}></textarea>
  </div>
  <div class="form__foot">
    <button type="submit" class="btn btn--primary" disabled={DESATIVADO}>{u.form.submit}</button>
    <p class="form__dados">{u.form.data} <a href={path('privacidade', lang)}>{u.form.dataLink}</a>.</p>
  </div>
</form>

<style>
  .form { display: flex; flex-direction: column; gap: 24px; }
  .form[hidden] { display: none; }
  .form__field { display: flex; flex-direction: column; gap: 8px; }
  .form label { font-weight: 600; font-size: 16px; color: var(--ink); }
  .form label span { font-weight: 400; color: var(--muted); }
  .form input, .form textarea, .form select { width: 100%; min-height: 48px; padding: 0 14px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-md); font: 400 17px/1.5 var(--sans); color: var(--ink); }
  .form textarea { padding: 12px 14px; resize: vertical; }
  .form input:disabled, .form textarea:disabled, .form select:disabled { opacity: 0.6; }
  /* Native option list follows the site theme (dark by default) */
  .form select { color-scheme: dark; }
  :global(html[data-theme="light"]) .form select { color-scheme: light; }
  .form [aria-invalid="true"] { border: 2px solid var(--ink); }
  .form__erro { margin: 0; font-weight: 600; font-size: 15px; color: var(--ink); }
  .form__ajuda { margin: 0; font-size: 15px; color: var(--muted); }
  .form__alert { padding: 16px 20px; border: 2px solid var(--ink); border-radius: var(--radius-md); font-weight: 600; color: var(--ink); }
  .form__aviso { margin: 0; padding: 16px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-md); font-size: 15px; line-height: 1.5; }
  .form__foot { display: flex; flex-direction: column; gap: 16px; padding-top: 8px; }
  .form__foot .btn { align-self: flex-start; min-height: 48px; padding: 0 24px; font-size: 17px; }
  .form__dados { margin: 0; font-size: 15px; line-height: 1.5; color: var(--muted); }
  .form__dados a { color: var(--ink-body); }
</style>

<script>
  // Client-side validation (on blur and on submit), per the information architecture.
  // Fields are listed in visual order, so focus goes to the first invalid one from the top.
  document.querySelectorAll<HTMLFormElement>('[data-contato-form]').forEach((form) => {
    // Path of the page the form is sent from (spec 01, origem.pagina)
    const pagina = form.querySelector<HTMLInputElement>('[name="pagina"]');
    if (pagina) pagina.value = location.pathname;
    const campos = ['nome', 'empresa', 'cargo', 'email', 'site'];
    const rx = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    // Website: optional; scheme may be omitted (https:// is added). Returns the normalized URL or null.
    const normalizaSite = (v: string): string | null => {
      if (/\s/.test(v)) return null;
      const comEsquema = /^[a-z][a-z0-9+.-]*:\/\//i.test(v) ? v : `https://${v}`;
      try {
        const url = new URL(comEsquema);
        if ((url.protocol === 'http:' || url.protocol === 'https:') && url.hostname.includes('.') && !/\s/.test(url.hostname)) return comEsquema;
      } catch { /* invalid URL */ }
      return null;
    };
    const valida = (name: string) => {
      const el = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
      if (!el) return true;
      const msg = form.querySelector<HTMLElement>(`#${el.id}-erro`);
      const v = el.value.trim();
      const ok = name === 'email' ? rx.test(v)
        : name === 'site' ? v === '' || normalizaSite(v) !== null
        : v.length > 0;
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      if (msg) msg.hidden = ok;
      return ok;
    };
    // Pressing the submit button blurs the current field first. Showing that field's error at this
    // point moves the button down before the press ends, so the click is lost. While the button is
    // pressed, blur validation waits: the submit handler validates every field anyway.
    let pressionandoEnviar = false;
    form.querySelector('button[type="submit"]')?.addEventListener('pointerdown', () => { pressionandoEnviar = true; });
    ['pointerup', 'pointercancel'].forEach((ev) => document.addEventListener(ev, () => { pressionandoEnviar = false; }, true));
    campos.forEach((c) => form.querySelector(`[name="${c}"]`)?.addEventListener('blur', () => { if (!pressionandoEnviar) valida(c); }));
    // A select is usually left right after choosing: validate on change too
    form.querySelector('[name="cargo"]')?.addEventListener('change', () => valida('cargo'));
    form.addEventListener('submit', (e) => {
      if (form.dataset.desativado) { e.preventDefault(); return; }
      const erros = campos.filter((c) => !valida(c));
      const resumo = form.querySelector<HTMLElement>('[data-resumo]');
      if (erros.length) {
        e.preventDefault();
        if (resumo) { resumo.hidden = false; resumo.textContent = erros.length === 1 ? (form.dataset.errOne || '') : (form.dataset.errMany || '').replace('{n}', String(erros.length)); resumo.focus(); }
        form.querySelector<HTMLElement>(`[name="${erros[0]}"]`)?.focus();
        return;
      }
      if (resumo) resumo.hidden = true;
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const rotulo = btn?.textContent || '';
      if (btn) { btn.disabled = true; btn.textContent = form.dataset.sending || '…'; }
      // Error line with the e-mail link; fields flagged by the server get their own message too
      const falha = (texto: string, camposServidor: string[] = [], comEmail = true) => {
        camposServidor.forEach((c) => {
          const el = form.querySelector<HTMLElement>(`[name="${c}"]`);
          const msg = el ? form.querySelector<HTMLElement>(`#${el.id}-erro`) : null;
          el?.setAttribute('aria-invalid', 'true');
          if (msg) msg.hidden = false;
        });
        if (resumo) {
          resumo.hidden = false;
          resumo.textContent = comEmail ? `${texto} ` : texto;
          if (comEmail) {
            const a = document.createElement('a');
            a.href = `mailto:${form.dataset.email}`;
            a.textContent = form.dataset.email || '';
            resumo.append(a, '.');
          }
          resumo.focus();
        }
        if (btn) { btn.disabled = false; btn.textContent = rotulo; }
      };
      // Fields go as typed (the server keeps the original and normalizes apart)
      fetch(form.dataset.funcao || '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
        .then(async (r) => {
          const corpo = await r.json().catch(() => ({}));
          if (r.status === 201) {
            // Success: the confirmation line takes the form's place
            const ok = form.previousElementSibling as HTMLElement | null;
            form.hidden = true;
            if (ok?.hasAttribute('data-contato-sucesso')) { ok.hidden = false; ok.focus(); }
            return;
          }
          if (r.status === 400 && Array.isArray(corpo.erros) && corpo.erros.length) {
            const n = corpo.erros.length;
            falha(n === 1 ? (form.dataset.errOne || '') : (form.dataset.errMany || '').replace('{n}', String(n)), corpo.erros, false);
            return;
          }
          falha(form.dataset.errUnavailable || '');
        })
        .catch(() => falha(form.dataset.errUnavailable || ''));
    });
  });
</script>
