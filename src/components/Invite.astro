---
// Closing invitation on the indigo background. [data-convite] tells the phone action bar to hide.
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/routes';
interface Props { title?: string; lang?: Lang; }
const { lang = 'pt-BR' } = Astro.props;
const u = t(lang);
const title = Astro.props.title ?? u.invite;
---
<section class="band-indigo" aria-labelledby="convite-titulo" data-convite>
  <div class="section container">
    <h2 id="convite-titulo" class="h1" style="max-width: 20ch; margin-bottom: 32px;">{title}</h2>
    <a class="btn btn--on-indigo" href={path('contato', lang)} data-abrir-contato>{u.cta}</a>
  </div>
</section>
