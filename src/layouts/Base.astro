---
// Base layout: head, header, main, footer, phone action bar and the contact dialog.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import ContactDialog from '../components/ContactDialog.astro';

interface Props {
  title: string;
  description: string;
  current?: string;
  path?: string;        // canonical path, e.g. "/casos/elite-90-pro"
  ctaSecondary?: boolean;
  noActionBar?: boolean;
  noDialog?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { title, description, current = '', path = '/', ctaSecondary = false, noActionBar = false, noDialog = false, jsonLd } = Astro.props;
import { DOMINIO } from '../config';
const fullTitle = title === 'GM Digital Bunker™' ? title : `${title} – GM Digital Bunker™`;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${DOMINIO}${path}`} />
  <link rel="alternate" hreflang="pt-BR" href={`${DOMINIO}${path}`} />
  <link rel="alternate" hreflang="en" href={`${DOMINIO}/en${path === '/' ? '/' : path}`} />
  <link rel="alternate" hreflang="x-default" href={`${DOMINIO}${path}`} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:url" content={`${DOMINIO}${path}`} />
  <meta property="og:site_name" content="GM Digital Bunker™" />
  <meta property="og:image" content={`${DOMINIO}/og/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="GM Digital Bunker™ – Estratégia de tecnologia e IA para o mundo real. Decisão sênior, executada com IA, até o artefato pronto." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${DOMINIO}/og/og-image.jpg`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Source+Sans+3:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script is:inline>
    // Apply the remembered theme before paint to avoid a flash
    try { if (localStorage.getItem('tema') === 'claro') document.documentElement.dataset.theme = 'light'; } catch (e) {}
  </script>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <Header current={current} ctaSecondary={ctaSecondary} />
  <main id="conteudo">
    <slot />
  </main>
  <Footer />
  {!noActionBar && <ActionBar secondary={ctaSecondary} />}
  {!noDialog && <ContactDialog />}
  <script>
    // Section reveal (Design System › Movimento): blocks fade in once, with an 8px lift,
    // when they enter the viewport. Cards inside a grid stagger up to five steps.
    // The hero and the page opening are never delayed; without JavaScript nothing is hidden.
    const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduz && 'IntersectionObserver' in window) {
      const alvos: HTMLElement[] = [];
      document.querySelectorAll<HTMLElement>('main section:not(.hero):not(.opening)').forEach((sec) => {
        const cont = sec.classList.contains('container') ? sec : sec.querySelector<HTMLElement>(':scope > .container') ?? sec;
        Array.from(cont.children).forEach((filho) => {
          const el = filho as HTMLElement;
          const grade = el.matches('.grid, .steps, .alternatives, .carousel__track, .evidence');
          if (grade) {
            Array.from(el.children).forEach((c, i) => { if (!(c as HTMLElement).classList.contains('steps__arrow')) { (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 5))); alvos.push(c as HTMLElement); } });
          } else if (el.matches('.carousel')) {
            const track = el.querySelector<HTMLElement>('.carousel__track');
            track && Array.from(track.children).forEach((c, i) => { (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 5))); alvos.push(c as HTMLElement); });
            const ctrl = el.querySelector<HTMLElement>('.carousel__controls'); ctrl && alvos.push(ctrl);
          } else {
            alvos.push(el);
          }
        });
      });
      const obs = new IntersectionObserver((entradas) => {
        entradas.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-visible'); obs.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -40px 0px', threshold: 0 });
      alvos.forEach((el) => { el.setAttribute('data-reveal', ''); obs.observe(el); });
    }
  </script>
</body>
</html>
