---
// Base layout: head, header, main, footer, phone action bar and the contact dialog.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import ContactDialog from '../components/ContactDialog.astro';

import { DOMINIO, INDEXAVEL } from '../config';
import { t } from '../i18n/ui';
import { grafo, emJson } from '../lib/schema';
import { path as routePath, otherLang, type Lang, type PageId } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  current?: string;
  pageId?: PageId;      // which page this is, in any language (routes.ts); gives canonical and hreflang
  path?: string;        // canonical path override
  lang?: Lang;
  ctaSecondary?: boolean;
  noActionBar?: boolean;
  noDialog?: boolean;
  noindex?: boolean;    // page never indexed (the 404): no canonical, no hreflang
}
const { title, description, current = '', pageId = 'inicio', lang = 'pt-BR', ctaSecondary = false, noActionBar = false, noDialog = false, noindex = false } = Astro.props;
// Search engines are kept out until the domain exists (src/lib/origem.mjs), and always out of the 404.
const robots = noindex || !INDEXAVEL;
const u = t(lang);
const path = Astro.props.path ?? routePath(pageId, lang);
const altPath = routePath(pageId, otherLang(lang));
const fullTitle = title === 'GM Digital Bunker™' ? title : `${title} – GM Digital Bunker™`;
const ogImage = lang === 'en' ? `${DOMINIO}/og/og-image-en.jpg` : `${DOMINIO}/og/og-image.jpg`;
const dados = noindex ? undefined : grafo({ lang, pageId, title: fullTitle, description });
const ogAlt = lang === 'en'
  ? 'GM Digital Bunker™ – AI technology strategy for the real world. Senior decisions, executed with AI, through to the finished artifact.'
  : 'GM Digital Bunker™ – Estratégia de tecnologia em IA para o mundo real. Decisão sênior, executada com IA, até o artefato pronto.';
---
<!doctype html>
<html lang={u.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content="noindex" />}
  {!noindex && (
    <>
      <link rel="canonical" href={`${DOMINIO}${path}`} />
      <link rel="alternate" hreflang="pt-BR" href={`${DOMINIO}${lang === 'pt-BR' ? path : altPath}`} />
      <link rel="alternate" hreflang="en" href={`${DOMINIO}${lang === 'en' ? path : altPath}`} />
      <link rel="alternate" hreflang="x-default" href={`${DOMINIO}${lang === 'pt-BR' ? path : altPath}`} />
    </>
  )}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={u.ogLocale} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'pt_BR' : 'en_US'} />
  {!noindex && <meta property="og:url" content={`${DOMINIO}${path}`} />}
  <meta property="og:site_name" content="GM Digital Bunker™" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Source+Sans+3:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script is:inline>
    // Apply the remembered theme before paint to avoid a flash
    try { if (localStorage.getItem('tema') === 'claro') document.documentElement.dataset.theme = 'light'; } catch (e) {}
  </script>
  {dados && <script type="application/ld+json" set:html={emJson(dados)} />}
</head>
<body>
  <a class="skip" href="#conteudo">{u.skip}</a>
  <Header current={current} ctaSecondary={ctaSecondary} lang={lang} pageId={pageId} />
  <main id="conteudo">
    <slot />
  </main>
  <Footer lang={lang} pageId={pageId} />
  {!noActionBar && <ActionBar secondary={ctaSecondary} lang={lang} />}
  {!noDialog && <ContactDialog lang={lang} />}
  <script>
    // Section reveal (Design System › Movimento): blocks fade in once, with an 8px lift,
    // when they enter the viewport. Cards inside a grid stagger up to five steps.
    // The hero and the page opening are never delayed; without JavaScript nothing is hidden.
    const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduz && 'IntersectionObserver' in window) {
      const alvos: HTMLElement[] = [];
      document.querySelectorAll<HTMLElement>('main section:not(.hero):not(.opening)').forEach((sec) => {
        const cont = sec.classList.contains('container') ? sec : sec.querySelector<HTMLElement>(':scope > .container') ?? sec;
        Array.from(cont.children).forEach((filho) => {
          const el = filho as HTMLElement;
          const grade = el.matches('.grid, .steps, .alternatives, .carousel__track, .evidence');
          if (grade) {
            Array.from(el.children).forEach((c, i) => { if (!(c as HTMLElement).classList.contains('steps__arrow')) { (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 5))); alvos.push(c as HTMLElement); } });
          } else if (el.matches('.carousel')) {
            const track = el.querySelector<HTMLElement>('.carousel__track');
            track && Array.from(track.children).forEach((c, i) => { (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 5))); alvos.push(c as HTMLElement); });
            const ctrl = el.querySelector<HTMLElement>('.carousel__controls'); ctrl && alvos.push(ctrl);
          } else {
            alvos.push(el);
          }
        });
      });
      const obs = new IntersectionObserver((entradas) => {
        entradas.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-visible'); obs.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -40px 0px', threshold: 0 });
      alvos.forEach((el) => { el.setAttribute('data-reveal', ''); obs.observe(el); });
    }
  </script>
</body>
</html>
