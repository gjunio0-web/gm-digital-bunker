---
// Admin hub (spec 05). This page is only the shell: Netlify rewrites every /admin/* address to it
// (netlify.toml) and the route is resolved in the browser after sign-in. It carries no lead data and
// no secret; FIREBASE_WEB holds the public web-app configuration of the environment, or null.
import '../styles/global.css';
import '../admin/admin.css';
import '../admin/leads/leads.css';
import JanelaMetodo from '../admin/leads/JanelaMetodo.astro';
import { FIREBASE_WEB } from '../config';
import fonteTitulo from '../../node_modules/@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import fonteTexto from '../../node_modules/@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Administração · GM Digital Bunker™</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href={fonteTitulo} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fonteTexto} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Apply the remembered theme before paint to avoid a flash (same key as the public site)
    try { if (localStorage.getItem('tema') === 'claro') document.documentElement.dataset.theme = 'light'; } catch (e) {}
  </script>
  <script type="application/json" id="firebase-web" set:html={JSON.stringify(FIREBASE_WEB)} />
</head>
<body class="adm">
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <h1 class="vh">Administração · GM Digital Bunker™</h1>

  <header class="site">
    <div class="wrap hd">
      <a class="brand" href="/admin" id="brandlink" data-interno>GM Digital Bunker™</a>
      <span class="tag">Administração</span>
      <div class="end">
        <button class="btn icon" type="button" id="themebtn" aria-label="Mudar para tema claro">
          <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path stroke-linecap="round" d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
        </button>
        <button class="btn secondary" type="button" id="sair" hidden>Sair</button>
      </div>
    </div>
  </header>

  <main id="conteudo">
    <!-- Until the sign-in state is known nothing is shown, so a signed-in user never sees the login flash -->
    <div class="view" id="carregando" aria-busy="true"></div>

    <section class="view" id="entrada" aria-labelledby="t-entrada" hidden>
      <div class="hero">
        <svg class="grain" aria-hidden="true" width="100%" height="100%"><filter id="g"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#g)"/></svg>
        <div class="wrap hero-in">
          <div>
            <p class="eyebrow">Acesso restrito</p>
            <h2 id="t-entrada">Entrar na administração</h2>
            <p class="lead">Área de gestão da prática: módulos de trabalho sobre os dados do site, atrás de uma única conta.</p>
          </div>
          <form class="login-card" id="loginform">
            <div class="field">
              <label for="f-email">E-mail <span class="opt">(obrigatório)</span></label>
              <input id="f-email" name="email" type="email" autocomplete="username" placeholder="contato@gmdigitalbunker.com.br" required />
            </div>
            <div class="field">
              <label for="f-senha">Senha <span class="opt">(obrigatório)</span></label>
              <input id="f-senha" name="senha" type="password" autocomplete="current-password" required />
            </div>
            <p class="login-erro" id="login-erro" role="alert" hidden></p>
            <button class="btn primary" type="submit">Entrar</button>
            <p class="login-meta">Conta única, criada no console do Firebase. Sem cadastro aberto.</p>
          </form>
        </div>
      </div>
    </section>

    <section class="view" id="modulos" aria-labelledby="t-modulos" hidden>
      <div class="wrap">
        <div class="vhead">
          <p class="eyebrow">Hub · Módulos</p>
          <h2 id="t-modulos" tabindex="-1">Módulos de administração</h2>
          <p class="lead">Cada módulo é um espaço de trabalho independente; novos módulos entram no hub sem alterar os existentes.</p>
        </div>
        <div class="grid" id="grade-modulos"></div>
      </div>
    </section>

    <!-- Module views render here (src/admin/registro.ts) -->
    <section class="view" id="rota" hidden></section>
  </main>

  <!-- Leads: method window, opened from the portfolio map (spec 05 §5.8) -->
  <JanelaMetodo />

  <footer class="site">
    <div class="wrap in">
      <span>GM Digital Bunker™ · Administração</span>
    </div>
  </footer>

  <script>
    import '../admin/app';
  </script>
</body>
</html>
