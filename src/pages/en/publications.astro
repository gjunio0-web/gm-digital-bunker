---
import Base from '../../layouts/Base.astro';
import Opening from '../../components/Opening.astro';
import Invite from '../../components/Invite.astro';
import { path } from '../../i18n/routes';
import { artigosDoHub } from '../../lib/artigos';
const L = 'en';
// Cards come from the AI Strategy Hub at build time: titles and summaries from its own English strings
// (i18n/en.json), most recent first.
const artigos = await artigosDoHub('en');
---
<Base
  lang={L}
  title="Publications"
  description="Articles on the When it's Better with AI method, published on the AI Strategy Hub."
  current="publicacoes"
  pageId="publicacoes"
>
  <Opening
    lang={L}
    crumbs={[{ label: 'Home', href: path('inicio', L) }, { label: 'Publications' }]}
    eyebrow="Publications"
    title="Publications"
    lead="Articles on the method, published on the AI Strategy Hub."
  />

  <section class="section container" aria-label="Articles">
    <div class="grid grid--2">
      {artigos.map((a) => (
        <a class="card" href={a.url}>
          <span class="eyebrow eyebrow--muted" style="margin: 0;">Article</span>
          <span class="h4" style="font-size: 24px;">{a.titulo}</span>
          <span class="small" style="flex: 1;">{a.resumo}</span>
          <span class="more">Read on the AI Strategy Hub <span aria-hidden="true">↗</span><span class="visually-hidden">external site</span></span>
        </a>
      ))}
    </div>
  </section>

  <Invite lang={L} />
</Base>
