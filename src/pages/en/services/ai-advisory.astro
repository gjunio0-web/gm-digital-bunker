---
import Base from '../../../layouts/Base.astro';
import Opening from '../../../components/Opening.astro';
import Invite from '../../../components/Invite.astro';
import { path } from '../../../i18n/routes';
const L = 'en';
---
<Base
  lang={L}
  title="AI advisory by subscription"
  description="A part-time AI executive for small and mid-sized companies: quarterly review of AI tools, vendor screening and support for decisions."
  current="servicos"
  pageId="conselho"
>
  <Opening
    lang={L}
    crumbs={[{ label: 'Home', href: path('inicio', L) }, { label: 'Services', href: path('servicos', L) }, { label: 'AI advisory by subscription' }]}
    eyebrow="Service"
    title="AI advisory by subscription"
    lead="A part-time AI executive for the company's artificial-intelligence decisions."
  />

  <section class="section container">
    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">What it is</h2>
      <p class="lead">A part-time AI executive: someone who looks after your company's artificial intelligence decisions without you having to hire that professional full time.</p>
    </div>

    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">Benefits for the company</h2>
      <ul class="list text">
        <li>A regular review of the AI tools the company pays for and uses, to know what is worth keeping.</li>
        <li>An independent second opinion before closing with an AI vendor. GM Digital Bunker™ takes no commissions from vendors.</li>
        <li>Support for AI decisions at the moment they come up, not only when a project is contracted.</li>
        <li>Predictable cost: a fixed monthly fee with an hour limit set in the contract.</li>
      </ul>
    </div>

    <aside class="card block" style="max-width: var(--container-text);" aria-label="Context figure">
      <span class="eyebrow eyebrow--muted" style="margin: 0;">Context</span>
      <span class="h4" style="font-size: 24px;">15% of small Brazilian companies used artificial intelligence in 2025, up from 10% in 2024.</span>
      <span class="small">Source: <a href="https://cetic.br/pt/noticia/uso-de-inteligencia-artificial-por-empresas-brasileiras-avanca-e-atinge-17-aponta-pesquisa-do-cetic-br/">Cetic.br, ICT Enterprises 2025 survey (companies with 10 to 49 people)</a>.</span>
    </aside>
  </section>

  <section class="band-indigo" aria-labelledby="funciona-titulo">
    <div class="section container">
      <p class="eyebrow">How it works</p>
      <h2 id="funciona-titulo" class="text" style="margin-bottom: 24px;">Monthly fee, quarterly review and a cap on hours</h2>
      <p class="lead text">The company pays a monthly fee. Each quarter, the AI tool portfolio is reviewed. Between reviews, vendor proposals and decision questions are analyzed within the contract's hour cap.</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="faq-titulo">
    <h2 id="faq-titulo" class="text" style="margin-bottom: 40px;">Frequently asked questions</h2>
    <div class="faq-plates">
      <div class="faq-plates__item">
        <span class="faq-plates__n" aria-hidden="true">01</span>
        <h3 class="faq-plates__t">How is AI advisory different from a consulting project?</h3>
        <p class="faq-plates__a">In a project, the work starts and ends with the delivery. In AI advisory, support is ongoing: a review every quarter and, between reviews, analysis of vendor proposals and decision questions, within the contract’s hour cap.</p>
      </div>
      <div class="faq-plates__item">
        <span class="faq-plates__n" aria-hidden="true">02</span>
        <h3 class="faq-plates__t">What is reviewed each quarter?</h3>
        <p class="faq-plates__a">The portfolio of AI tools the company pays for and uses, to know what is worth keeping.</p>
      </div>
      <div class="faq-plates__item">
        <span class="faq-plates__n" aria-hidden="true">03</span>
        <h3 class="faq-plates__t">Does the company need to hire a full-time AI executive?</h3>
        <p class="faq-plates__a">No. The service exists so that someone looks after the company’s artificial intelligence decisions without that professional being hired full time.</p>
      </div>
      <div class="faq-plates__item">
        <span class="faq-plates__n" aria-hidden="true">04</span>
        <h3 class="faq-plates__t">Does GM Digital Bunker™ take commissions from the vendors it analyzes?</h3>
        <p class="faq-plates__a">No. That is why the analysis of a vendor proposal is an independent second opinion.</p>
      </div>
    </div>
  </section>

  <Invite lang={L} />
</Base>
