---
import Base from '../../../layouts/Base.astro';
import Opening from '../../../components/Opening.astro';
import Invite from '../../../components/Invite.astro';
import Faq from '../../../components/Faq.astro';
import { path } from '../../../i18n/routes';
import Foto from '../../../components/Foto.astro';
import { fotoCaso } from '../../../assets/imagens';
const L = 'en';
const faqTitulo = "Frequently asked questions";
const faq = [
  {
    "q": "Where does the project start?",
    "a": "With a diagnosis and a master plan with the execution roadmap in stages."
  },
  {
    "q": "Does the company have to wait for the project to end to use the platform?",
    "a": "No. Construction proceeds module by module, and each module goes into production when it is ready."
  },
  {
    "q": "Where does artificial intelligence come in?",
    "a": "In scenarios where it reduces or replaces manual work, where it improves a process that continues to exist and where it expands the capacity of those who decide – and the diagnosis says which of the three fits each point of the operation. In Elite 90 Pro, all three coexist: automation for lead screening; optimization to improve answers to questions about the program; augmentation when AI writes the preliminary version of the athletes’ assessments, to be reviewed by the specialist professional."
  },
  {
    "q": "Who looks after the system after delivery?",
    "a": "Whoever built it. A monthly contract covers hosting, fixes and small improvements, and what counts as a small improvement is set down in writing."
  },
  {
    "q": "Does GM Digital Bunker™ take commissions on the tools chosen?",
    "a": "No. The choice of tools is vendor-independent."
  },
  {
    "q": "Does GM Digital Bunker™ deploy, configure or maintain third-party tools?",
    "a": "No. For off-the-shelf tools, we help choose, evaluate and monitor them; deployment, configuration and technical training stay with the vendor. We build and maintain only the platforms we develop ourselves."
  }
];
---
<Base
  lang={L}
  title="AI strategy and digital platform"
  description="A tailored project that goes from strategic diagnosis to a digital platform in production, with AI where it actually reduces work."
  current="servicos"
  pageId="estrategia"
>
  <Opening
    lang={L}
    crumbs={[{ label: 'Home', href: path('inicio', L) }, { label: 'Services', href: path('servicos', L) }, { label: 'AI strategy and digital platform' }]}
    eyebrow="Service"
    title="AI strategy and digital platform"
    lead="A tailored project that goes from strategic diagnosis to your company's digital platform in production, with artificial intelligence where it actually reduces work. Example: the Elite 90 Pro program platform."
  />

  <section class="section container">
    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">Benefits for the company</h2>
      <ul class="list text">
        <li>Strategy before code: the diagnosis defines what to build and in what order.</li>
        <li>A platform of your own, built module by module, with parts in production before the project ends.</li>
        <li>AI applied where it reduces manual work, such as the lead screening in Elite 90 Pro.</li>
        <li>Vendor independence in the choice of tools: GM Digital Bunker™ takes no commissions.</li>
      </ul>
    </div>

    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">How it works</h2>
      <p class="lead">The project starts with a diagnosis, including the company’s business architecture (capabilities, processes and value chain), and a master plan with the execution roadmap in stages. Construction proceeds module by module, and each module goes into production when it is ready.</p>
    </div>

    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">What the project includes</h2>
      <ul class="list text">
        <li>Prototypes and requirements.</li>
        <li>Module-by-module construction using AI.</li>
        <li>Integrations.</li>
        <li>Security and privacy.</li>
        <li>Guides and team training.</li>
        <li>Usage measurement.</li>
      </ul>
      <p class="text" style="margin-top: 16px;">Depending on the characteristics and needs of the business, the project may also include an AI assistant for users and the migration of spreadsheets and data.</p>
    </div>

    <aside class="card block" style="max-width: var(--container-text);" aria-label="Context figure">
      <span class="eyebrow eyebrow--muted" style="margin: 0;">Context</span>
      <span class="h4" style="font-size: 24px;">17% of Brazilian companies used artificial intelligence in 2025, up from 13% in 2024.</span>
      <span class="small">Source: <a href="https://cetic.br/pt/noticia/uso-de-inteligencia-artificial-por-empresas-brasileiras-avanca-e-atinge-17-aponta-pesquisa-do-cetic-br/">Cetic.br, ICT Enterprises 2025 survey (companies with 10 or more people)</a>.</span>
    </aside>
  </section>

  <section class="band-indigo" aria-labelledby="depois-titulo">
    <div class="section container">
      <p class="eyebrow">After delivery</p>
      <h2 id="depois-titulo" class="text" style="margin-bottom: 24px;">The relationship does not end at delivery</h2>
      <p class="lead text" style="margin-bottom: 32px;">The systems GM Digital Bunker built, such as portals and web applications, can remain under its care after the project is delivered: a monthly contract covers hosting, fixes and small improvements. What counts as a ‘small improvement’ is set down in writing in the contract.</p>
      <div class="grid grid--3">
        <div class="card"><p class="small">The system stays online, fixed and updated, without you having to look for another supplier who does not know the code.</p></div>
        <div class="card"><p class="small">Whoever built it maintains it.</p></div>
        <div class="card"><p class="small">Small improvements are part of the contract, with no new quote for every adjustment.</p></div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="caso-titulo">
    <p class="eyebrow">Case</p>
    <h2 id="caso-titulo" class="text" style="margin-bottom: 32px;">A project from this service</h2>
    <div class="grid grid--2">
      <a class="card" href={path('caso', L)}>
        <Foto img={fotoCaso} tipo="tela" alt="Home page of the Coach Ruiz program website: Build an athlete's body in 90 days" class="proof-img" />
        <span class="eyebrow eyebrow--muted" style="margin: 0;">Case</span>
        <span class="h4" style="font-size: 24px;">Elite 90 Pro</span>
        <span class="small" style="flex: 1;">A 90-day physical transformation program for executives, led by Coach Ruiz. GM Digital Bunker designed the program's digital ecosystem and leads its construction module by module.</span>
        <span class="more">Read the case <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <Faq kind="rows" title={faqTitulo} items={faq} />

  <Invite lang={L} />
</Base>
