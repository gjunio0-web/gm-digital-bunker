---
import Base from '../../layouts/Base.astro';
import Opening from '../../components/Opening.astro';
import Invite from '../../components/Invite.astro';
import { path } from '../../i18n/routes';
import { LINKEDIN, HUB } from '../../config';
import Foto from '../../components/Foto.astro';
import { fotoRetrato } from '../../assets/imagens';
const L = 'en';
---
<Base
  lang={L}
  title="About GM Digital Bunker™"
  description="What GM Digital Bunker™ is and who leads it: Gonçalo Marques, author of When it's Better with AI."
  current="sobre"
  pageId="sobre"
 
>
  <Opening
    lang={L}
    crumbs={[{ label: 'Home', href: path('inicio', L) }, { label: 'About' }]}
    eyebrow="About"
    title="About GM Digital Bunker™"
    lead="GM Digital Bunker™ is an independent technology strategy practice focused on the advanced application of artificial intelligence, from strategic analysis to the production of technical and communication artifacts."
  />

  <section class="section container" aria-labelledby="diferenciais-titulo">
    <h2 id="diferenciais-titulo" class="text" style="margin-bottom: 32px;">Three differentiators</h2>
    <div class="grid grid--3">
      <div class="card"><h3 class="h4">Vendor independence</h3><p class="small">The practice takes no commission from any tool it recommends.</p></div>
      <div class="card"><h3 class="h4">A method of its own, published</h3><p class="small">Anyone can check the criteria behind each recommendation.</p></div>
      <div class="card"><h3 class="h4">Complete delivery</h3><p class="small">The work goes from diagnosis to the finished artifact, that is, to the system, document or material the company starts using, and does not stop at the report.</p></div>
    </div>
  </section>

  <section class="band-indigo" aria-labelledby="conduz-titulo">
    <div class="section container">
      <p class="eyebrow">Who leads it</p>
      <h2 id="conduz-titulo" class="text" style="margin-bottom: 32px;">Gonçalo Marques</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: flex-start;">
        <Foto img={fotoRetrato} tipo="retrato" alt="Gonçalo Marques" class="portrait" />
        <div class="prose text" style="flex: 1 1 480px;">
          <p>The practice is led by Gonçalo Marques, author of the book <a href={path('livro', L)}>When it's Better with AI</a> and creator of the <a href={`${HUB}/?lang=en`}>AI Strategy Hub</a>. He brings nearly 30 years of corporate experience in strategy, technology and architecture, at companies such as Microsoft, Accenture, Cogna and Acelera Partners.</p>
          <p>He is an electrical engineer from the University of Campinas (Unicamp), with graduate specializations from Fundação Getulio Vargas (FGV) in Project and Portfolio Management and in Knowledge Management. He holds the Leading SAFe (Scaled Agile Framework) and ITIL Foundation certifications. He has written technology book reviews for the newspaper O Estado de S. Paulo.</p>
          <p><a href={LINKEDIN}>Gonçalo Marques on LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden">external site</span></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="artefato-titulo">
    <div class="artefato">
      <h2 id="artefato-titulo" class="text artefato__t">This website is an artifact of the method</h2>
      <p class="lead text artefato__p">The decisions about what this site says, how it is organized and how it looks were Gonçalo Marques's, who validated every page before publishing it. Artificial intelligence, under his direction, produced the text in both languages, the code, the design system and the sharing images. The checks followed verifiable criteria: color contrast on all 22 pages, in light and dark themes; internal links and equivalence between the Portuguese and English versions.</p>
      <figure class="artefato__fig" aria-hidden="true"><svg class="artefato__art" viewBox="0 0 400 320" preserveAspectRatio="xMaxYMid slice" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg"><line x1="0" y1="0" x2="0" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="40" y1="0" x2="40" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="80" y1="0" x2="80" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="120" y1="0" x2="120" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="160" y1="0" x2="160" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="200" y1="0" x2="200" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="240" y1="0" x2="240" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="280" y1="0" x2="280" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="320" y1="0" x2="320" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="360" y1="0" x2="360" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="400" y1="0" x2="400" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="0" x2="400" y2="0" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="40" x2="400" y2="40" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="80" x2="400" y2="80" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="120" x2="400" y2="120" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="160" x2="400" y2="160" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="200" x2="400" y2="200" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="240" x2="400" y2="240" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="280" x2="400" y2="280" stroke="var(--line)" stroke-width="1" opacity="0.7"/><line x1="0" y1="320" x2="400" y2="320" stroke="var(--line)" stroke-width="1" opacity="0.7"/><polygon points="90,150 400,0 400,170" fill="var(--indigo)"/><polygon points="90,150 400,170 400,262" fill="var(--indigo-deep)"/><polygon points="90,150 400,262 226,320" fill="var(--accent)" opacity="0.9"/><line x1="90" y1="150" x2="0" y2="118" stroke="var(--line-strong)" stroke-width="1"/><line x1="90" y1="150" x2="0" y2="176" stroke="var(--line-strong)" stroke-width="1"/><line x1="90" y1="150" x2="40" y2="320" stroke="var(--line-strong)" stroke-width="1" stroke-dasharray="3 4"/><circle cx="90" cy="150" r="3.5" fill="var(--ink)"/></svg></figure>
    </div>
  </section>

  <Invite lang={L} />
</Base>

<style>
  /* Heading, text and figure share one grid; the figure spans both rows so it runs from the heading's top edge to the text's bottom edge. */
  .artefato { display: grid; gap: 24px 40px; }
  .artefato__t { margin: 0; }
  .artefato__p { max-width: 60ch; margin: 0; }
  .artefato__fig { margin: 0; }
  .artefato__art { display: block; width: 100%; height: auto; }
  @media (min-width: 900px) {
    .artefato { grid-template-columns: minmax(0, 1fr) minmax(300px, 400px); gap: 24px 56px; grid-template-rows: auto 1fr; }
    .artefato__fig { grid-column: 2; grid-row: 1 / span 2; align-self: stretch; }
    .artefato__art { height: 100%; }
  }
</style>
