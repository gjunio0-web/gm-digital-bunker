---
import Base from '../layouts/Base.astro';
import { DOMINIO } from '../config';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'GM Digital Bunker™',
  description: 'Prática independente de estratégia tecnológica voltada à aplicação avançada de inteligência artificial, da análise estratégica à produção de artefatos técnicos e de comunicação.',
  url: `${DOMINIO}/`,
  areaServed: 'BR',
  founder: { '@type': 'Person', name: 'Gonçalo Marques' },
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
};
---
<Base title="GM Digital Bunker™" description="Estratégia de tecnologia e IA para o mundo real. Decisão sênior, executada com IA, até o artefato pronto, para empresas de pequeno e médio porte." current="inicio" path="/" jsonLd={jsonLd}>

  <!-- Opening: scenario 4 (tactile brutalism, kinetic colour bands, grid, grain) -->
  <section class="hero" id="abertura" aria-labelledby="capa-titulo">
    <div class="hero__bands" aria-hidden="true"></div>
    <div class="hero__wedge" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <svg class="hero__grain" aria-hidden="true"><filter id="grao-capa"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#grao-capa)"/></svg>
    <p class="hero__meta hero__meta--left" aria-hidden="true">GM Digital Bunker™</p>
    <p class="hero__meta hero__meta--right" aria-hidden="true">Estratégia · Tecnologia · IA · 2026</p>
    <div class="container hero__content">
      <div class="hero__plate">
        <p class="eyebrow hero__who" style="margin-bottom: 16px;"><a href="/sobre">Gonçalo Marques</a> · São Paulo</p>
        <h1 id="capa-titulo" class="display" style="margin-bottom: 20px;">Estratégia de tecnologia e IA para o <span>mundo real</span>.</h1>
        <p class="lead" style="margin-bottom: 32px; max-width: 36rem;">Para empresas de pequeno e médio porte que precisam decidir e executar em tecnologia e IA, da análise estratégica ao artefato pronto.</p>
        <div class="actions">
          <a class="btn btn--secondary" href="/servicos">Ver serviços</a>
          <a class="btn btn--text" href="/metodo">Conhecer o método <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <button type="button" class="hero__pause" data-pausa aria-pressed="false">Pausar animação</button>
  </section>

  <!-- 01 -->
  <section class="section container" id="oportunidade" aria-labelledby="oportunidade-titulo">
    <p class="eyebrow">01 · A oportunidade</p>
    <h2 id="oportunidade-titulo" class="text" style="margin-bottom: 16px;">A IA já chegou à operação. O critério para usá-la ainda é frágil.</h2>
    <p class="lead" style="margin-bottom: 48px;">Por que a empresa média usa IA com pouco critério e sem uma opção de apoio adequada</p>

    <div class="carousel" data-carrossel>
      <div class="carousel__window" role="region" aria-roledescription="carrossel" aria-label="Três números sobre a oportunidade">
        <div class="carousel__track grid grid--3">
          <div class="card">
            <p class="figure">65%</p>
            <p class="small" style="flex: 1;">das empresas de pequeno porte já usam IA, na maioria ferramentas de texto como ChatGPT, Gemini e Copilot</p>
            <p class="meta">Sebrae, 2025</p>
          </div>
          <div class="card">
            <p class="figure">74,3%</p>
            <p class="small" style="flex: 1;">citam o custo alto como principal barreira às tecnologias digitais avançadas</p>
            <p class="meta">IBGE, Pintec Semestral 2024*</p>
          </div>
          <div class="card">
            <p class="figure">60,6%</p>
            <p class="small" style="flex: 1;">citam a falta de pessoal qualificado, a barreira que mais cresceu desde 2022</p>
            <p class="meta">IBGE, Pintec Semestral 2024*</p>
          </div>
        </div>
      </div>
      <div class="carousel__controls">
        <button type="button" class="btn btn--icon" data-anterior aria-label="Número anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg></button>
        <p class="meta" aria-live="polite" data-posicao>1 de 3</p>
        <button type="button" class="btn btn--icon" data-proximo aria-label="Próximo número"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></button>
      </div>
    </div>
    <p class="meta" style="margin: 12px 0 0;">* Indústrias com 100 ou mais funcionários que não adotam tecnologias digitais avançadas.</p>

    <h3 class="text" style="margin: 64px 0 24px;">As opções disponíveis não foram desenhadas para a empresa média</h3>
    <div class="grid grid--3 alternatives">
      <details class="card alt" open>
        <summary><span><h4>Grandes consultorias</h4><span class="tag">Fora de escala em preço e formato</span></span><span class="alt__plus" aria-hidden="true">+</span></summary>
        <p class="small">Receitas de US$ 14 bi a US$ 75 bi por ano, programas plurianuais e equipes em pirâmide. Só a Accenture fechou 33 contratos acima de US$ 100 milhões em um único trimestre.</p>
      </details>
      <details class="card alt" open>
        <summary><span><h4>Fornecedores de ferramenta</h4><span class="tag">Ferramenta antes do critério</span></span><span class="alt__plus" aria-hidden="true">+</span></summary>
        <p class="small">Entregam o produto, raramente a decisão de se, onde e como usar IA. A recomendação tende a partir do catálogo, e não do problema do negócio.</p>
      </details>
      <details class="card alt" open>
        <summary><span><h4>Uso espontâneo</h4><span class="tag">Esforço sem direção</span></span><span class="alt__plus" aria-hidden="true">+</span></summary>
        <p class="small">Cada pessoa adota a própria ferramenta, sem um critério comum. O risco é gastar sem retorno ou expor dados sem perceber.</p>
      </details>
    </div>

    <h3 class="text" style="margin: 64px 0 8px;">O espaço vazio: decisão sênior para empresas médias</h3>
    <p class="meta" style="margin: 0 0 24px;">Mapa qualitativo, não medido: mostra zonas.</p>
    <div class="map">
      <span class="map__axis-name map__axis-name--y">Escopo ↑</span>
      <span class="map__y-top">Estratégia e decisão</span>
      <div class="map__grid">
        <div class="card map__cell map__cell--us"><p class="h4" style="font-size: 20px;">GM Digital Bunker™</p><p class="small">Estratégia sênior até o artefato pronto, sem pirâmide de equipe</p></div>
        <div class="card map__cell"><p class="h4" style="font-size: 20px;">Estratégia pura</p><p class="small">Com braços de construção próprios</p></div>
        <div class="card map__cell"><p class="h4" style="font-size: 20px;">Ferramentas e execução</p><p class="small">Fornecedores de ferramenta, agências e desenvolvedores</p></div>
        <div class="card map__cell"><p class="h4" style="font-size: 20px;">Integradoras e grandes consultorias</p><p class="small">Programas plurianuais para grandes corporações e governo</p></div>
      </div>
      <span class="map__y-bottom">Implantação e operação</span>
      <div class="map__x">
        <span>Pequena e média empresa</span>
        <span class="map__axis-name">Porte do cliente →</span>
        <span style="text-align: right;">Grande corporação e governo</span>
      </div>
    </div>

    <div class="statement">
      <p>Critério antes da ferramenta.</p>
      <p>Decisão sênior, executada com IA, até o artefato pronto.</p>
    </div>
  </section>

  <!-- 02 -->
  <section class="band-indigo" id="proposta" aria-labelledby="proposta-titulo">
    <div class="section container">
      <p class="eyebrow">02 · A proposta</p>
      <h2 id="proposta-titulo" class="text" style="margin-bottom: 48px;">Do diagnóstico ao artefato pronto</h2>
      <ol class="steps">
        <li class="card"><span class="meta step__n">01</span><h3>Diagnóstico</h3><p class="small">Entender o negócio, a operação e onde a IA de fato ajuda – e onde atrapalha.</p></li>
        <li class="steps__arrow" aria-hidden="true">→</li>
        <li class="card"><span class="meta step__n">02</span><h3>Decisão</h3><p class="small">Critério claro para escolher prioridades e ferramentas, sem vínculo com fornecedor.</p></li>
        <li class="steps__arrow" aria-hidden="true">→</li>
        <li class="card"><span class="meta step__n">03</span><h3>Artefato</h3><p class="small">Documento técnico, protótipo, aplicação ou material para a equipe, pronto para uso.</p></li>
      </ol>
      <p class="lead" style="margin-top: 32px; color: var(--ink);">A entrega termina em algo utilizável, no formato em que será usado.</p>
      <div class="statement">
        <p>Sem pirâmide. Com entrega.</p>
        <p>Quem diagnostica é quem entrega: um sênior que decide, com a IA na produção.</p>
      </div>
    </div>
  </section>

  <!-- 03 -->
  <section class="section container" id="servicos" aria-labelledby="servicos-titulo">
    <p class="eyebrow">03 · Serviços</p>
    <h2 id="servicos-titulo" class="text" style="margin-bottom: 48px;">O que a empresa pode contratar</h2>
    <div class="grid grid--2">
      <a class="card" href="/servicos/estrategia-e-plataforma-digital-com-ia">
        <span class="eyebrow eyebrow--muted" style="margin: 0;">Serviço</span>
        <span class="h4" style="font-size: 24px;">Estratégia e plataforma digital com IA</span>
        <span class="small" style="flex: 1;">Projeto sob medida, do diagnóstico à plataforma em produção; Elite 90 Pro como caso.</span>
        <span class="more">Ver o serviço <span aria-hidden="true">→</span></span>
      </a>
      <a class="card" href="/servicos/conselho-de-ia">
        <span class="eyebrow eyebrow--muted" style="margin: 0;">Serviço</span>
        <span class="h4" style="font-size: 24px;">Conselho de IA por assinatura</span>
        <span class="small" style="flex: 1;">Executivo de IA fracionado: revisão trimestral, triagem de fornecedores e teto de horas.</span>
        <span class="more">Ver o serviço <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <!-- 04 -->
  <section class="band-indigo" id="provas" aria-labelledby="provas-titulo">
    <div class="section container">
      <p class="eyebrow">04 · As provas</p>
      <h2 id="provas-titulo" class="text" style="margin-bottom: 48px;">Um caso real, o método publicado e a evidência externa</h2>
      <div class="grid grid--3">
        <a class="card" href="/casos/elite-90-pro">
          <img src="/imagens/elite-90-pro-site.jpg" alt="Página inicial do site do programa Coach Ruiz: Construa um corpo de atleta em 90 dias" width="1920" height="1080" loading="lazy" class="proof-img" />
          <span class="eyebrow eyebrow--muted" style="margin: 0;">Caso</span>
          <span class="h4" style="font-size: 24px;">Elite 90 Pro</span>
          <span class="small" style="flex: 1;">Programa de 90 dias de transformação física para executivos, conduzido pelo Coach Ruiz. A GM Digital Bunker desenhou o ecossistema digital do programa e conduz sua construção por módulos.</span>
          <span class="more">Ler o caso <span aria-hidden="true">→</span></span>
        </a>
        <a class="card" href="/metodo/livro">
          <span class="proof-frame"><img src="/imagens/capa-quando-e-melhor-com-ia.jpg" alt="Capa do livro Quando é Melhor com IA, de Gonçalo Marques" width="1000" height="1600" loading="lazy" /></span>
          <span class="eyebrow eyebrow--muted" style="margin: 0;">O livro</span>
          <span class="h4" style="font-size: 24px;">Quando é Melhor com&nbsp;IA</span>
          <span class="small" style="flex: 1;">Como aplicar IA com rigor e método na produção técnica, na análise complexa e no apoio à decisão estratégica.</span>
          <span class="more">Conhecer o livro <span aria-hidden="true">→</span></span>
        </a>
        <a class="card" href="https://ai-strat-hub.netlify.app">
          <img src="/imagens/ai-strategy-hub.jpg" alt='Tela do AI Strategy Hub: perfil profissional "Cirurgião de Código" selecionado e ranking recomendado com o gráfico de capacidades' width="1920" height="1080" loading="lazy" class="proof-img" />
          <span class="eyebrow eyebrow--muted" style="margin: 0;">Aplicativo gratuito</span>
          <span class="h4" style="font-size: 24px;">AI Strategy Hub</span>
          <span class="small" style="flex: 1;">Painel gratuito na web que indica a IA mais adequada a cada perfil de trabalho.</span>
          <span class="more">Abrir o AI Strategy Hub <span aria-hidden="true">↗</span><span class="visually-hidden">site externo</span></span>
        </a>
      </div>
      <p class="bridge">Os textos sobre o método estão em <a href="/publicacoes">Publicações <span aria-hidden="true">→</span></a></p>

      <h3 class="text" style="margin: 64px 0 24px;">A IA amplia o trabalho de consultoria, quando se sabe onde usá-la</h3>
      <div class="grid grid--4 evidence">
        <div><p class="figure">+12,2%</p><p class="small">mais tarefas concluídas</p></div>
        <div><p class="figure">25,1%</p><p class="small">mais rapidez na execução</p></div>
        <div><p class="figure">+40%</p><p class="small">de qualidade, ou mais</p></div>
        <div><p class="figure">−19</p><p class="small">pontos percentuais de acerto em tarefa fora do alcance da IA</p></div>
      </div>
      <p class="lead" style="margin: 32px 0 8px; color: var(--ink);">O ganho depende de saber quando a IA ajuda e quando atrapalha. É a pergunta que dá nome ao método: quando é melhor com IA.</p>
      <p class="meta">Estudo de campo da Harvard Business School com a BCG, 758 consultores (Dell'Acqua et al., SSRN, 2023)</p>
      <div class="statement">
        <p>Quando é melhor com IA?</p>
        <p>Responder a essa pergunta, caso a caso, é o trabalho.</p>
      </div>
    </div>
  </section>

  <!-- 05 -->
  <section class="section container" id="encaixe" aria-labelledby="encaixe-titulo">
    <p class="eyebrow">05 · O encaixe e o próximo passo</p>
    <h2 id="encaixe-titulo" class="text" style="margin-bottom: 48px;">Desenhada para empresas sem executivo exclusivamente dedicado a tecnologia</h2>
    <dl class="criteria">
      <div><dt>Porte</dt><dd>Média empresa (receita anual de R$ 4,8 mi a R$ 300 mi) e pequena empresa em crescimento</dd></div>
      <div><dt>Tecnologia</dt><dd>Sem diretor dedicado a tecnologia (CIO ou CTO); TI enxuta, terceirizada ou operacional</dd></div>
      <div><dt>Decisor</dt><dd>CEO, sócio ou diretor de área, que compra resultado de negócio</dd></div>
      <div><dt>Momento</dt><dd>IA ainda não adotada ou já em uso espontâneo, sem critério comum para decidir onde e quando investir</dd></div>
      <div><dt>Expectativa</dt><dd>Decisão fundamentada e algo utilizável no fim do projeto</dd></div>
    </dl>
    <p class="meta" style="margin: 12px 0 0;">Faixa de porte pela classificação do BNDES.</p>
    <h3 style="margin: 64px 0 24px;">O que a GM Digital Bunker não faz</h3>
    <div class="grid grid--3">
      <div class="card"><h4>Operação em larga escala</h4><p class="small">Implantações com dezenas de pessoas ou operação 24 horas pedem outro tipo de fornecedor.</p></div>
      <div class="card"><h4>Revenda de ferramentas</h4><p class="small">Sem vínculo comercial com fornecedores: a recomendação parte do problema do negócio.</p></div>
      <div class="card"><h4>Promessas sem fonte</h4><p class="small">Ganhos são medidos ou declarados como estimativa, nunca apresentados como garantia.</p></div>
    </div>
  </section>

  <!-- Invitation -->
  <section class="band-indigo" aria-labelledby="convite-titulo" data-convite>
    <div class="section container">
      <h2 id="convite-titulo" class="h1" style="max-width: 20ch; margin-bottom: 32px;">Vamos conversar sobre onde e quando é melhor com IA no seu negócio.</h2>
      <a class="btn btn--on-indigo" href="/contato" data-abrir-contato>Agendar conversa</a>
    </div>
  </section>
  <!-- Section index (desktop): follows the scroll, jumps to a section on click; hidden over the hero -->
  <nav class="rail" aria-label="Seções desta página" data-rail>
    <ol>
      <li><a href="#oportunidade"><span class="rail__n">01</span><span class="rail__l">A oportunidade</span></a></li>
      <li><a href="#proposta"><span class="rail__n">02</span><span class="rail__l">A proposta</span></a></li>
      <li><a href="#servicos"><span class="rail__n">03</span><span class="rail__l">Serviços</span></a></li>
      <li><a href="#provas"><span class="rail__n">04</span><span class="rail__l">As provas</span></a></li>
      <li><a href="#encaixe"><span class="rail__n">05</span><span class="rail__l">O encaixe</span></a></li>
    </ol>
  </nav>
</Base>

<style>
  /* Section index rail */
  .rail { display: none; }
  @media (min-width: 1280px) {
    .rail { display: block; position: fixed; right: 32px; top: 50%; transform: translateY(-50%); z-index: 15; opacity: 0; visibility: hidden; transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
    .rail.is-shown { opacity: 1; visibility: visible; transition-delay: 0s; }
    .rail ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
    .rail a { display: flex; align-items: center; gap: 10px; min-height: 32px; padding: 0 8px; font: 500 12px/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); text-decoration: none; border-right: 1px solid var(--line); transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .rail a:hover, .rail a:focus-visible { color: var(--ink); }
    .rail__l { max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0; transition: max-width var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out); }
    .rail a[aria-current="true"] { color: var(--ink); border-right-color: var(--accent); }
    .rail a:hover .rail__l, .rail a:focus-visible .rail__l { max-width: 160px; opacity: 1; }
    /* Over an indigo band the rail takes that band's palette */
    .rail.on-indigo a { color: #f4f3ff; border-right-color: rgba(255, 255, 255, 0.35); }
    .rail.on-indigo a:hover, .rail.on-indigo a:focus-visible, .rail.on-indigo a[aria-current="true"] { color: #fff; }
    .rail.on-indigo a[aria-current="true"] { border-right-color: #fff; }
    .rail ol { align-items: flex-end; }
  }

  /* Bridges from the home narrative to pages the menu alone would reach */
  .hero__who a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .hero__who a:hover { color: var(--accent-hover); }
  .bridge { margin: 24px 0 0; font-size: 16px; line-height: 1.5; }
  .bridge a { font-weight: 600; }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }

  /* Carousel: a grid on desktop, one card at a time with arrows on phones */
  .carousel__controls { display: none; }
  @media (max-width: 767px) {
    .carousel__window { overflow: hidden; margin-right: calc(-1 * var(--gutter)); }
    .carousel__track { display: flex; gap: 12px; transition: transform var(--dur-base) var(--ease-out); transform: translateX(var(--deslocamento, 0)); }
    .carousel__track > .card { flex: 0 0 78%; }
    .carousel__controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
    .carousel__controls p { margin: 0; }
    .carousel__controls .btn[disabled] { opacity: 0.35; }
  }

  /* Alternatives: always open cards on desktop, accordion on phones */
  .alt summary { display: flex; list-style: none; pointer-events: none; }
  .alt summary::-webkit-details-marker { display: none; }
  .alt summary > span:first-child { flex: 1; display: flex; flex-direction: column; gap: 12px; }
  .alt .tag { align-self: flex-start; padding: 4px 8px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font: 500 12px/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); }
  .alt__plus { display: none; }
  @media (max-width: 767px) {
    .alternatives { gap: 8px; }
    .alt { padding: 0 16px; }
    .alt summary { pointer-events: auto; align-items: flex-start; gap: 16px; padding: 16px 0; cursor: pointer; }
    .alt__plus { display: block; flex-shrink: 0; font: 400 22px/1 var(--sans); color: var(--ink); }
    .alt[open] .alt__plus { transform: rotate(45deg); }
    .alt > p { margin: 0 0 16px; }
  }

  /* Market map */
  .map { display: grid; grid-template-columns: 88px minmax(0, 1fr); grid-template-areas: "axis grid" "axis x"; gap: 8px 12px; }
  .map__axis-name { font: 500 12px/1.4 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); }
  .map__axis-name--y { grid-area: axis; align-self: center; text-align: right; }
  .map__y-top, .map__y-bottom { grid-area: axis; font: 500 12px/1.4 var(--mono); letter-spacing: 0.04em; color: var(--muted); text-align: right; }
  .map__y-top { align-self: start; padding-top: 8px; }
  .map__y-bottom { align-self: end; padding-bottom: 8px; }
  .map__grid { grid-area: grid; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 12px; border-left: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .map__cell { gap: 8px; padding: 20px; }
  .map__cell--us { border: 2px solid var(--accent); }
  .map__x { grid-area: x; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: 8px; font: 500 12px/1.4 var(--mono); letter-spacing: 0.04em; color: var(--muted); }
  @media (max-width: 767px) {
    .map { grid-template-columns: minmax(0, 1fr); grid-template-areas: "axis" "top" "grid" "bottom" "x"; gap: 8px; }
    .map__axis-name--y { text-align: left; }
    .map__y-top { grid-area: top; text-align: left; padding: 0; }
    .map__y-bottom { grid-area: bottom; text-align: left; padding: 0; }
    .map__grid { gap: 8px; padding: 8px 0 8px 8px; }
    .map__cell { padding: 12px; }
    .map__cell .h4 { font-size: 16px !important; line-height: 1.25; }
    .map__cell .small { font-size: 14px; line-height: 1.45; }
  }

  /* Steps */
</style>

<script>
  // Hero: pause and resume all background layers
  const hero = document.getElementById('abertura');
  const pausa = hero?.querySelector<HTMLButtonElement>('[data-pausa]');
  pausa?.addEventListener('click', () => {
    const pausado = hero!.classList.toggle('is-paused');
    pausa.setAttribute('aria-pressed', String(pausado));
    pausa.textContent = pausado ? 'Retomar animação' : 'Pausar animação';
  });

  // Phone carousel: arrows and swipe, one card per step, no free scrolling
  const car = document.querySelector<HTMLElement>('[data-carrossel]');
  if (car) {
    const track = car.querySelector<HTMLElement>('.carousel__track')!;
    const cards = Array.from(track.children) as HTMLElement[];
    const ant = car.querySelector<HTMLButtonElement>('[data-anterior]')!;
    const prox = car.querySelector<HTMLButtonElement>('[data-proximo]')!;
    const pos = car.querySelector<HTMLElement>('[data-posicao]')!;
    let i = 0;
    const render = () => {
      const compacto = window.matchMedia('(max-width: 767px)').matches;
      const ultimo = i === cards.length - 1;
      // 78% cards with 12px gaps; the last card aligns to the right edge
      const desloc = !compacto ? '0' : ultimo ? `calc(-${(cards.length - 1) * 78}% - ${(cards.length - 1) * 12}px + 22% - ${getComputedStyle(car).getPropertyValue('--gutter') || '16px'})` : `calc(-${i * 78}% - ${i * 12}px)`;
      track.style.setProperty('--deslocamento', desloc);
      ant.disabled = i === 0; prox.disabled = ultimo;
      pos.textContent = `${i + 1} de ${cards.length}`;
      cards.forEach((c, k) => c.setAttribute('aria-hidden', compacto && k !== i ? 'true' : 'false'));
    };
    const ir = (n: number) => { i = Math.max(0, Math.min(cards.length - 1, n)); render(); };
    ant.addEventListener('click', () => ir(i - 1));
    prox.addEventListener('click', () => ir(i + 1));
    let x0: number | null = null;
    car.addEventListener('touchstart', (e) => { x0 = e.touches[0]?.clientX ?? null; }, { passive: true });
    car.addEventListener('touchend', (e) => { const x1 = e.changedTouches[0]?.clientX; if (x0 == null || x1 == null) return; if (x1 - x0 < -40) ir(i + 1); else if (x1 - x0 > 40) ir(i - 1); x0 = null; });
    window.addEventListener('resize', render);
    render();
  }

  // Section index rail: shown once the hero has passed; the active item is the last section
  // whose top is above the middle of the viewport.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail) {
    const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('a'));
    const secs = links.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') || ''));
    const hero = document.getElementById('abertura');
    const convite = document.querySelector<HTMLElement>('[data-convite]');
    const atualiza = () => {
      const meio = window.innerHeight / 2;
      const depoisDaCapa = hero ? hero.getBoundingClientRect().bottom < 80 : true;
      const antesDoConvite = convite ? convite.getBoundingClientRect().top > meio : true;
      rail.classList.toggle('is-shown', depoisDaCapa && antesDoConvite);
      let ativo = -1;
      secs.forEach((sec, i) => { if (sec && sec.getBoundingClientRect().top <= meio) ativo = i; });
      links.forEach((a, i) => { if (i === ativo) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
      // Palette: what sits behind the rail at mid-height
      const atras = document.elementFromPoint(window.innerWidth - 40, meio)?.closest('.band-indigo');
      rail.classList.toggle('on-indigo', !!atras);
    };
    atualiza();
    window.addEventListener('scroll', atualiza, { passive: true });
    window.addEventListener('resize', atualiza);
  }

  // Alternatives: closed on phones, always open on desktop
  const alts = document.querySelectorAll<HTMLDetailsElement>('.alt');
  const compactoMQ = window.matchMedia('(max-width: 767px)');
  const ajustaAlt = () => { alts.forEach((d) => { d.open = !compactoMQ.matches; }); };
  ajustaAlt();
  compactoMQ.addEventListener('change', ajustaAlt);

  // Accordion motion (Design System › Movimento): the panel grows or shrinks over 200ms
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  alts.forEach((d) => {
    const painel = d.querySelector<HTMLElement>(':scope > p');
    const resumo = d.querySelector<HTMLElement>('summary');
    if (!painel || !resumo) return;
    let animando = false;
    resumo.addEventListener('click', (e) => {
      if (!compactoMQ.matches || semMovimento || !painel.animate) return; // native toggle
      e.preventDefault();
      if (animando) return;
      animando = true;
      const opts = { duration: 200, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' };
      if (d.open) {
        const h = painel.offsetHeight;
        painel.style.overflow = 'hidden';
        const a = painel.animate([{ height: `${h}px`, opacity: 1, marginBottom: '16px' }, { height: '0px', opacity: 0, marginBottom: '0px' }], opts);
        a.onfinish = () => { d.open = false; painel.style.overflow = ''; animando = false; };
      } else {
        d.open = true;
        const h = painel.offsetHeight;
        painel.style.overflow = 'hidden';
        const a = painel.animate([{ height: '0px', opacity: 0, marginBottom: '0px' }, { height: `${h}px`, opacity: 1, marginBottom: '16px' }], opts);
        a.onfinish = () => { painel.style.overflow = ''; animando = false; };
      }
    });
  });
</script>
