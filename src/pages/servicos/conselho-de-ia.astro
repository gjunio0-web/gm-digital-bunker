---
import Base from '../../layouts/Base.astro';
import Opening from '../../components/Opening.astro';
import Invite from '../../components/Invite.astro';
import Faq from '../../components/Faq.astro';
const faqTitulo = "Perguntas frequentes";
const faq = [
  {
    "q": "Em que o Conselho de IA difere de um projeto de consultoria?",
    "a": "No projeto, o trabalho começa e termina com a entrega. No Conselho, o apoio é contínuo: uma revisão a cada trimestre e, entre as revisões, a análise de propostas de fornecedores e de dúvidas de decisão, dentro do teto de horas do contrato."
  },
  {
    "q": "O que é revisado a cada trimestre?",
    "a": "O portfólio de ferramentas de IA que a empresa paga e usa, para saber o que vale manter."
  },
  {
    "q": "A empresa precisa contratar um executivo de IA em tempo integral?",
    "a": "Não. O serviço existe para que alguém cuide das decisões de inteligência artificial da empresa sem que esse profissional seja contratado em tempo integral."
  },
  {
    "q": "A GM Digital Bunker™ recebe comissão dos fornecedores que analisa?",
    "a": "Não. Por isso a análise de uma proposta de fornecedor é uma segunda opinião independente."
  },
  {
    "q": "A GM Digital Bunker™ implanta, configura ou mantém ferramentas de terceiros?",
    "a": "Não. Nas ferramentas de mercado, ajudamos a escolher, avaliar e acompanhar; a implantação, a configuração e o treinamento técnico ficam com o fornecedor. Construímos e mantemos só as plataformas que nós mesmos desenvolvemos."
  }
];
---
<Base
  title="Conselho de IA por assinatura"
  description="Executivo de IA em tempo parcial para empresas de pequeno e médio porte: revisão trimestral das ferramentas de IA, triagem de fornecedores e apoio às decisões."
  current="servicos"
  pageId="conselho"
>
  <Opening
    crumbs={[{ label: 'Início', href: '/' }, { label: 'Serviços', href: '/servicos' }, { label: 'Conselho de IA por assinatura' }]}
    eyebrow="Serviço"
    title="Conselho de IA por assinatura"
    lead="Um executivo de IA em tempo parcial para as decisões de inteligência artificial da empresa."
  />

  <section class="section container">
    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">O que é</h2>
      <p class="lead">Um executivo de IA em tempo parcial: alguém que cuida das decisões de inteligência artificial da sua empresa sem que você precise contratar esse profissional em tempo integral.</p>
    </div>

    <div class="block">
      <h2 class="text" style="margin-bottom: 24px;">Benefícios para a empresa</h2>
      <ul class="list text">
        <li>Uma revisão regular das ferramentas de IA que a empresa paga e usa, para saber o que vale manter.</li>
        <li>Uma segunda opinião independente antes de fechar com um fornecedor de IA. A GM Digital Bunker™ não recebe comissão de fornecedores.</li>
        <li>Apoio nas decisões de IA no momento em que elas aparecem, e não só quando um projeto é contratado.</li>
        <li>Custo previsível: mensalidade fixa com limite de horas definido em contrato.</li>
        <li>Governança do uso de IA: política de uso, mapa de riscos, acompanhamento dos fornecedores e avaliação de cada uso novo de IA à luz da LGPD, antes da adoção.</li>
        <li>Orientação em temas que pedem especialista, como contratos com fornecedores de IA e grandes plataformas corporativas, com indicação de quem executa.</li>
      </ul>
    </div>

    <aside class="card block" style="max-width: var(--container-text);" aria-label="Dado de contexto">
      <span class="eyebrow eyebrow--muted" style="margin: 0;">Contexto</span>
      <span class="h4" style="font-size: 24px;">15% das pequenas empresas brasileiras usaram inteligência artificial em 2025, contra 10% em 2024.</span>
      <span class="small">Fonte: <a href="https://cetic.br/pt/noticia/uso-de-inteligencia-artificial-por-empresas-brasileiras-avanca-e-atinge-17-aponta-pesquisa-do-cetic-br/">Cetic.br, pesquisa TIC Empresas 2025 (empresas de 10 a 49 pessoas)</a>.</span>
    </aside>
  </section>

  <section class="band-indigo" aria-labelledby="funciona-titulo">
    <div class="section container">
      <p class="eyebrow">Como funciona</p>
      <h2 id="funciona-titulo" class="text" style="margin-bottom: 24px;">Mensalidade, revisão trimestral e teto de horas</h2>
      <p class="lead text">A empresa paga uma mensalidade. A cada trimestre, o portfólio de ferramentas de IA é revisado. Entre as revisões, propostas de fornecedores e dúvidas de decisão são analisadas dentro do teto de horas do contrato.</p>
    </div>
  </section>

  <Faq kind="plates" title={faqTitulo} items={faq} />

  <Invite />
</Base>
