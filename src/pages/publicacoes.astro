---
import Base from '../layouts/Base.astro';
import Opening from '../components/Opening.astro';
import Invite from '../components/Invite.astro';
import { artigosDoHub, ultimaPublicacao } from '../lib/artigos';
// Cards come from the AI Strategy Hub at build time (artigos/index.json), most recent first.
const artigos = await artigosDoHub();
const atualizadoMinimo = await ultimaPublicacao();
---
<Base
  title="Publicações"
  description="Artigos sobre o método Quando é Melhor com IA, publicados no AI Strategy Hub."
  current="publicacoes"
  pageId="publicacoes"
  atualizadoMinimo={atualizadoMinimo}
>
  <Opening
    crumbs={[{ label: 'Início', href: '/' }, { label: 'Publicações' }]}
    eyebrow="Publicações"
    title="Publicações"
    lead="Textos sobre o método, publicados no AI Strategy Hub."
  />

  <section class="section container" aria-label="Artigos">
    <div class="grid grid--2">
      {artigos.map((a) => (
        <a class="card" href={a.url}>
          <span class="eyebrow eyebrow--muted" style="margin: 0;">Artigo</span>
          <span class="h4" style="font-size: 24px;">{a.titulo}</span>
          <span class="small" style="flex: 1;">{a.resumo}</span>
          <span class="more">Ler no AI Strategy Hub <span aria-hidden="true">↗</span><span class="visually-hidden">site externo</span></span>
        </a>
      ))}
    </div>
  </section>

  <Invite />
</Base>
