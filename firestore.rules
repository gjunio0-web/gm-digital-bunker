rules_version = '2';

// Spec 01, section 5. Clients never write: every write goes through Cloud Functions (Admin SDK).
// Reading requires a signed-in user with a document in usuarios/{uid} whose papel is admin or leitor.
service cloud.firestore {
  match /databases/{database}/documents {
    function temPapel() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel in ['admin', 'leitor'];
    }

    match /fichas/{caminho=**} {
      allow read: if temPapel();
      allow write: if false;
    }
    match /config/{doc} {
      allow read: if temPapel();
      allow write: if false;
    }
    match /metricas/{doc} {
      allow read: if temPapel();
      allow write: if false;
    }
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Anything else (including the legacy contatos and limites collections) stays closed.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
